# Copy to .env (never commit .env). Only the backend reads these.
ANTHROPIC_API_KEY=sk-ant-...
# Cheapest current model; with another model, change the two prices below too
MODEL=claude-haiku-4-5
# Comma-separated list of sites allowed to call the API
ALLOWED_ORIGINS=https://mohamadnajjari.github.io
# "anthropic" (real) or "mock" (local testing without an API key)
LLM_MODE=anthropic
# Abuse protection (comments on their own lines: Docker's env_file keeps text after a value)
# Questions per visitor per window, and the window in seconds
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=600
# Hard cap on questions from all visitors together per day
DAILY_REQUEST_CAP=400
# Money: what the assistant may spend (USD), from the real token usage of every answer.
# Refuses politely when used up; set the Anthropic console's spend limit as well.
DAILY_BUDGET_USD=0.50
MONTHLY_BUDGET_USD=5
INPUT_USD_PER_MTOK=1
OUTPUT_USD_PER_MTOK=5
# Set true only behind Cloudflare: the visitor's address then comes from CF-Connecting-IP
TRUST_PROXY_HEADERS=false
