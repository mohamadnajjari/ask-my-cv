# Copy to .env (never commit .env). Only the backend reads these.
ANTHROPIC_API_KEY=sk-ant-...
# Cheapest current model; switch to claude-sonnet-5-5 for higher quality
MODEL=claude-haiku-4-5-20251001
# Comma-separated list of sites allowed to call the API
ALLOWED_ORIGINS=https://mohamadnajjari.github.io
# "anthropic" (real) or "mock" (local testing without an API key)
LLM_MODE=anthropic
# Abuse / cost protection
RATE_LIMIT_PER_IP=20          # requests per IP per window
RATE_LIMIT_WINDOW_SECONDS=600
DAILY_REQUEST_CAP=400         # hard cap for all visitors per day
# Set true only when running behind a reverse proxy you control (nginx, Render, Fly)
TRUST_PROXY_HEADERS=false
